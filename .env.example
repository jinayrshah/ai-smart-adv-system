# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Market Data
DATA_GOV_IN_KEY=your-personal-datagov-api-key
CEDA_API_KEY=your-ceda-api-key

# Weather
OPENWEATHER_API_KEY=your-openweather-api-key
WEATHER_ONDEMAND_MAX_NEW_GRIDS=300

# AI: Groq (free tier, no billing) is tried first when set; Gemini is the fallback
# Comma-separated keys, e.g. one per Groq account; they rotate and skip any that are rate-limited
GROQ_API_KEYS=
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct

# AI / Gemini
GEMINI_API_KEY=your-gemini-api-key

# Logging
LOG_LEVEL=INFO
# Gemini model ids are config (models are retired on a schedule); fallbacks tried in order
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# Bhashini (ULCA) translation for hi / mr / gu / kn / te answers (README §8)
BHASHINI_USER_ID=your-ulca-user-id
BHASHINI_API_KEY=your-ulca-api-key
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# FastAPI security
# Comma-separated browser origins allowed to call FastAPI directly ("*" disables credentials)
CORS_ALLOW_ORIGINS=http://localhost:3000
# Days of weather history backfilled from a crop's sowing date for GDD / water balance
WEATHER_HISTORY_BACKFILL_MAX_DAYS=240

# Express server (server.ts)
# Required in production: signs login tokens (server.ts) and is verified by FastAPI farmer routes, so both read this same value
JWT_SECRET=change-me-to-a-long-random-string
# Where the Express server proxies /api/advisory, /api/farmer, /api/market/* etc.
FASTAPI_URL=http://127.0.0.1:8000
